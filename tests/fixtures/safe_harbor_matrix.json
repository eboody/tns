[
  {
    "name": "markdown_client_email_replace",
    "kind": "text",
    "input": "client_email.md",
    "config": "client_config.toml",
    "mode": "replace",
    "expected_output_contains": ["CLIENT emailed [EMAIL_ADDRESS]."],
    "expected_audit_contains": [
      "configured client variant exact match",
      "EMAIL_ADDRESS",
      "\"review_flags\"",
      "\"ml_active\": false",
      "\"has_ml_findings\": false",
      "\"extraction_status\": \"clean_text\""
    ]
  },
  {
    "name": "text_provider_email_replace",
    "kind": "text",
    "input": "provider_email.txt",
    "config": "provider_config.toml",
    "mode": "replace",
    "expected_output_contains": ["PROVIDER_1 emailed [EMAIL_ADDRESS]."],
    "expected_audit_contains": ["configured provider variant exact match", "EMAIL_ADDRESS"]
  },
  {
    "name": "review_policy_and_category_summary",
    "kind": "text",
    "input": "policy_review.md",
    "config": null,
    "mode": "review",
    "expected_review_contains": [
      "[policy:DATE_TIME] 2003-01-02 -> 2003",
      "[policy:AGE] age 94 -> 90 or older",
      "[custom:FAX_NUMBER] (555) 123-4567 -> [FAX_NUMBER]",
      "- Category 3: dates except year / ages over 89",
      "- Category 5: fax numbers",
      "- Category 6: email addresses",
      "Residual review risk summary:",
      "Residual gap categories still open: 5"
    ]
  },
  {
    "name": "review_custom_address_category",
    "kind": "text",
    "input": "address_review.md",
    "config": null,
    "mode": "review",
    "expected_review_contains": [
      "[custom:ADDRESS] 123 Main Street, Los Angeles, CA 90001 -> [ADDRESS]",
      "- Category 2: geographic subdivisions smaller than a state"
    ]
  },
  {
    "name": "psychology_labeled_context_replace",
    "kind": "text",
    "input": "psychology_labels.md",
    "config": null,
    "mode": "replace",
    "expected_output_contains": [
      "Client: [CLIENT]",
      "Provider: [PROVIDER]",
      "Mother: [FAMILY_MEMBER]",
      "School: [INSTITUTION]",
      "Email: [EMAIL_ADDRESS]"
    ],
    "expected_audit_contains": [
      "\"entity_type\": \"CLIENT_NAME\"",
      "\"entity_type\": \"PROVIDER_NAME\"",
      "\"entity_type\": \"FAMILY_NAME\"",
      "\"entity_type\": \"INSTITUTION_NAME\""
    ]
  },
  {
    "name": "psychology_labeled_context_review",
    "kind": "text",
    "input": "psychology_labels.md",
    "config": null,
    "mode": "review",
    "expected_review_contains": [
      "[custom:CLIENT_NAME] Jane Doe -> [CLIENT]",
      "[custom:PROVIDER_NAME] Shina Halavi, PhD -> [PROVIDER]",
      "[custom:FAMILY_NAME] Janet Doe -> [FAMILY_MEMBER]",
      "[custom:INSTITUTION_NAME] Archer School for Girls -> [INSTITUTION]",
      "- Category 1: names",
      "- Category 2: geographic subdivisions smaller than a state",
      "Deterministic custom contextual findings to sanity-check in context: 4"
    ]
  },
  {
    "name": "docx_markdown_extraction_and_nontext_placeholder",
    "kind": "docx",
    "input": "docx_document.xml",
    "config": "client_config.toml",
    "mode": "replace",
    "expected_output_contains": [
      "CLIENT emailed [EMAIL_ADDRESS].",
      "Image follows [OMITTED_NON_TEXT_CONTENT]"
    ],
    "expected_audit_contains": [
      "\"non_text_omissions_detected\": true",
      "\"extraction_status\": \"non_text_omissions\""
    ]
  },
  {
    "name": "docx_review_surfaces_nontext_omission_status",
    "kind": "docx",
    "input": "docx_document.xml",
    "config": "client_config.toml",
    "mode": "review",
    "expected_review_contains": [
      "non-text extraction omissions detected: yes",
      "extraction status: non_text_omissions"
    ]
  },
  {
    "name": "pdf_extractable_replace",
    "kind": "pdf",
    "input": "pdf_text.txt",
    "config": "client_config.toml",
    "mode": "replace",
    "expected_output_contains": ["CLIENT emailed [EMAIL_ADDRESS]."]
  },
  {
    "name": "ner_missing_model_fails_explicitly",
